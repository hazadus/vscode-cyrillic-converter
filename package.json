{
  "name": "cyrillic-latin-converter",
  "displayName": "Cyrillic to Latin Converter",
  "description": "Автоматическая замена кириллицы на латиницу в коде с поддержкой контекста",
  "version": "1.0.0",
  "publisher": "your-publisher",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "cyrillic",
    "latin",
    "converter",
    "keyboard",
    "layout"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cyrillicLatin.toggle",
        "title": "Toggle Cyrillic → Latin Conversion",
        "icon": "$(keyboard)"
      },
      {
        "command": "cyrillicLatin.convertSelection",
        "title": "Convert Selected Text"
      },
      {
        "command": "cyrillicLatin.testKeyboardLayout",
        "title": "Test Keyboard Layout Switch"
      },
      {
        "command": "cyrillicLatin.resetKeyboardLayoutErrors",
        "title": "Reset Keyboard Layout Error Counter"
      }
    ],
    "configuration": {
      "title": "Cyrillic Latin Converter",
      "properties": {
        "cyrillicLatin.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Включить автоматическую замену"
        },
        "cyrillicLatin.languages": {
          "type": "object",
          "default": {
            "javascript": true,
            "typescript": true,
            "vue": true,
            "python": true,
            "go": true
          },
          "description": "Включить для определенных языков"
        },
        "cyrillicLatin.debounceDelay": {
          "type": "number",
          "default": 300,
          "description": "Задержка в миллисекундах перед обработкой"
        },
        "cyrillicLatin.triggerLength": {
          "type": "number",
          "default": 1,
          "description": "Минимальное количество символов для срабатывания"
        },
        "cyrillicLatin.replaceInComments": {
          "type": "boolean",
          "default": false,
          "description": "Заменять символы в комментариях"
        },
        "cyrillicLatin.replaceInStrings": {
          "type": "boolean",
          "default": false,
          "description": "Заменять символы в строках"
        },
        "cyrillicLatin.showNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Показывать уведомления о замене"
        },
        "cyrillicLatin.switchKeyboardLayout": {
          "type": "boolean",
          "default": false,
          "description": "Автоматически переключать раскладку клавиатуры на латиницу (только macOS)"
        },
        "cyrillicLatin.targetKeyboardLayout": {
          "type": "string",
          "default": "com.apple.keylayout.US",
          "enum": [
            "com.apple.keylayout.US",
            "com.apple.keylayout.ABC"
          ],
          "enumDescriptions": [
            "U.S. (стандартная американская раскладка)",
            "ABC (упрощенная американская раскладка)"
          ],
          "description": "Целевая раскладка клавиатуры для переключения (только macOS)"
        }
      }
    },
    "keybindings": [
      {
        "command": "cyrillicLatin.toggle",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "^8.47.0",
    "typescript": "^5.1.6"
  }
}
